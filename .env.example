# Copy to .env and edit. See README.md for details.

# Required
API_TOKEN=your_tubearchivist_api_token
API_URL=http://tubearchivist:8457/api

# Optional
VIDEO_URL=http://tubearchivist:8457/video/
SCAN_INTERVAL=60
ALLOWED_IPS=127.0.0.1,192.168.1.0/24
TRUSTED_PROXY_COUNT=0
SESSION_COOKIE_SECURE=false

# Host-side path of the TubeArchivist downloads folder, as media clients see it.
HOST_SOURCE_BASE=/mnt/user/tubearchivist/downloads

# In-container paths; only change if you also change docker-compose.yml.
#SOURCE_DIR=/app/source
#TARGET_DIR=/app/target
#HIDDEN_DIR=/app/hidden
#IMPORT_DIR=/app/import
#DATA_DIR=/app/data
