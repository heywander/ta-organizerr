---
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";
const isAuthPage = path === "/login" || path === "/setup";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta
            name="description"
            content="TubeSorter — organized access to a TubeArchivist library"
        />
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1, viewport-fit=cover"
        />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} | TubeSorter</title>
        <script is:inline>document.documentElement.classList.add("js");</script>
    </head>
    <body>
        <div class="app-frame">
            <header class="app-header">
                <div class="app-header__row">
                    <a class="brand" href={isAuthPage ? "/login" : "/"}>
                        <i class="bi bi-collection-play-fill brand__mark"></i>
                        <span>
                            <span class="brand__name">TubeSorter</span>
                            <span class="brand__meta">Archive organizer</span>
                        </span>
                    </a>

                    {
                        !isAuthPage && (
                            <Fragment>
                                <button
                                    id="nav-menu-toggle"
                                    class="nav-menu-toggle"
                                    type="button"
                                    aria-expanded="false"
                                    aria-controls="primary-navigation"
                                    aria-label="Open primary navigation"
                                >
                                    <i class="bi bi-list" aria-hidden="true"></i>
                                    <span>Menu</span>
                                </button>
                                <nav
                                    id="primary-navigation"
                                    class="nav-tabs"
                                    aria-label="Primary navigation"
                                    data-open="false"
                                >
                                <a
                                    href="/"
                                    aria-label="Library"
                                    aria-current={path === "/" ? "page" : undefined}
                                >
                                    <i class="bi bi-grid-1x2-fill"></i>
                                    <span class="nav-label">Library</span>
                                </a>
                                <a
                                    href="/transcode"
                                    aria-label="Transcode"
                                    aria-current={path === "/transcode" ? "page" : undefined}
                                >
                                    <i class="bi bi-film"></i>
                                    <span class="nav-label">Transcode</span>
                                </a>
                                <a
                                    href="/maintenance"
                                    aria-label="Maintenance"
                                    aria-current={path === "/maintenance" ? "page" : undefined}
                                >
                                    <i class="bi bi-tools"></i>
                                    <span class="nav-label">Maintenance</span>
                                </a>
                                <a
                                    href="/reconciliation"
                                    aria-label="Link Reconciliation"
                                    aria-current={path === "/reconciliation" ? "page" : undefined}
                                >
                                    <i class="bi bi-link-45deg"></i>
                                    <span class="nav-label">Links</span>
                                </a>
                                <a
                                    href="/salvage"
                                    aria-label="Media Salvage"
                                    aria-current={path === "/salvage" ? "page" : undefined}
                                >
                                    <i class="bi bi-life-preserver"></i>
                                    <span class="nav-label">Salvage</span>
                                </a>
                                <a
                                    href="/availability"
                                    aria-label="Channel and video availability"
                                    aria-current={path === "/availability" ? "page" : undefined}
                                >
                                    <i class="bi bi-broadcast-pin"></i>
                                    <span class="nav-label">Availability</span>
                                </a>
                                <button id="logout-btn" type="button" aria-label="Sign out">
                                    <i class="bi bi-box-arrow-right"></i>
                                    <span class="nav-label">Sign out</span>
                                </button>
                                </nav>
                            </Fragment>
                        )
                    }

                    <div class="connection-state" aria-label="Session state">
                        <span class="connection-state__dot"></span>
                        <span class="connection-state__label">
                            {isAuthPage ? "Local access" : "Session active"}
                        </span>
                    </div>
                </div>
            </header>

            <main class="app-main">
                <slot />
            </main>

        </div>

        <script>
            const logoutBtn = document.getElementById("logout-btn");
            const navMenuToggle = document.getElementById("nav-menu-toggle");
            const primaryNavigation = document.getElementById("primary-navigation");
            const appHeader = document.querySelector(".app-header");
            const mobileNavigation = window.matchMedia("(max-width: 1023px)");

            const setMobileNavigationOpen = (open, returnFocus = false) => {
                if (!navMenuToggle || !primaryNavigation) return;
                const shouldOpen = mobileNavigation.matches && open;
                primaryNavigation.dataset.open = String(shouldOpen);
                navMenuToggle.setAttribute("aria-expanded", String(shouldOpen));
                navMenuToggle.setAttribute(
                    "aria-label",
                    shouldOpen ? "Close primary navigation" : "Open primary navigation",
                );
                const icon = navMenuToggle.querySelector("i");
                icon?.classList.toggle("bi-list", !shouldOpen);
                icon?.classList.toggle("bi-x-lg", shouldOpen);
                if (returnFocus && navMenuToggle instanceof HTMLElement) {
                    navMenuToggle.focus();
                }
            };

            navMenuToggle?.addEventListener("click", () => {
                const isOpen = navMenuToggle.getAttribute("aria-expanded") === "true";
                setMobileNavigationOpen(!isOpen);
            });

            primaryNavigation?.addEventListener("click", (event) => {
                if (
                    event.target instanceof Element &&
                    event.target.closest("a, button")
                ) {
                    setMobileNavigationOpen(false, true);
                }
            });

            document.addEventListener("click", (event) => {
                if (
                    navMenuToggle?.getAttribute("aria-expanded") === "true" &&
                    event.target instanceof Node &&
                    !appHeader?.contains(event.target)
                ) {
                    setMobileNavigationOpen(
                        false,
                        primaryNavigation?.contains(document.activeElement) ?? false,
                    );
                }
            });

            document.addEventListener("keydown", (event) => {
                if (
                    event.key === "Escape" &&
                    navMenuToggle?.getAttribute("aria-expanded") === "true"
                ) {
                    setMobileNavigationOpen(false, true);
                }
            });

            mobileNavigation.addEventListener("change", () => {
                setMobileNavigationOpen(
                    false,
                    mobileNavigation.matches &&
                        (primaryNavigation?.contains(document.activeElement) ?? false),
                );
            });

            logoutBtn?.addEventListener("click", async () => {
                try {
                    const res = await fetch("/api/auth/logout", { method: "POST" });
                    if (res.ok) window.location.href = "/login";
                } catch (err) {
                    console.error("Logout failed", err);
                }
            });
        </script>
    </body>
</html>
